# ---- Database passwords (dev defaults; change them for anything shared) ----
MYSQL_ROOT_PASSWORD=1
MONGO_PASSWORD=root
NEO4J_PASSWORD=spring+neo4j

# ---- Security ----
# Generate one: openssl rand -base64 64
JWT_SIGNER_KEY=replace-me-with-a-random-64-byte-base64-key
SENDINBLUE_API_KEY=replace-me

# ---- Versions / ports ----
ELASTIC_VERSION=9.2.8
WEB_PORT=3000

# ---- Only needed if you run services from an IDE on ANOTHER machine ----
# Set it to this machine's IP so external Kafka clients can reach the broker.
KAFKA_EXTERNAL_HOST=localhost
